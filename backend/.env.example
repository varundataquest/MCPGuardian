# MCP Guardian backend environment variables
# Copy to .env and fill in values. Do not commit secrets.

# --- Supabase (required for backend writes) ---
# URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# Service role key with database write access. Keep private.
SUPABASE_SERVICE_ROLE_KEY=

# Anonymous public key (optional; typically used by the UI only)
SUPABASE_ANON_KEY=

# --- OpenAI (optional) ---
# Enables natural-language → structured filter translation for /search.
# If unset, backend falls back to Postgres FTS/ILIKE.
OPENAI_API_KEY=

# --- GitHub (optional but recommended) ---
# Personal access token or GitHub App token for higher rate limits and repo metadata
# (topics, license, stars, forks, issues, pushed_at). If unset, GitHub enrichment is skipped.
GITHUB_TOKEN=

# --- Crawler knobs ---
# User-Agent used for all crawling requests.
CRAWL_USER_AGENT=MCPGuardianBot/0.1 (+https://example.com/mcpguardian)

# Max concurrent outbound requests across the crawl (bounded concurrency).
CRAWL_MAX_CONCURRENCY=5

# Per-host rate limit (requests/second). Applies per registry domain and discovered hostnames.
CRAWL_RATE_LIMIT_PER_HOST=2

# Max pages or "load more" iterations per registry to avoid runaway crawls.
CRAWL_MAX_PAGES_GLAMA=10
CRAWL_MAX_PAGES_MCPSO=10
CRAWL_MAX_PAGES_PULSEMCP=10

# HTTP retry/backoff configuration for 429/5xx
HTTP_BACKOFF_BASE_SECONDS=1.0
HTTP_MAX_RETRIES=5

# --- Scheduling ---
# Cron expression for the nightly crawl (local timezone unless containerized scheduling is used)
NIGHTLY_CRAWL_CRON=0 3 * * *

# --- API/Server ---
# Host/port for the FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# log level: critical|error|warning|info|debug
LOG_LEVEL=info

# --- Frontend integration ---
# Base URL the UI will call for API requests in dev
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Notes:
# - Never commit real keys to version control.
# - OPENAI_API_KEY and GITHUB_TOKEN are optional; functionality degrades gracefully when absent.
# - Page size and input clamps are enforced server-side regardless of env values.
